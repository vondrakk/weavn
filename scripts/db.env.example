# Local dev (Podman): run `./scripts/pg.sh up`, then use:
export DATABASE_URL="postgresql://weavn:weavn@localhost:5432/weavn"

# Supabase (cloud): Project → Settings → Database → Connection string (URI). Use the
# session/pooler URI; URL-encode the password if it has special characters.
# export DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"
