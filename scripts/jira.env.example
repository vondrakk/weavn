# Copy this file to  scripts/jira.env  (git-ignored) and fill in your values.
# NEVER commit scripts/jira.env, and never paste the token into chat.
# scripts/jira.sh sources this file.

export WEAVN_JIRA_BASE="https://your-site.atlassian.net"
export WEAVN_JIRA_EMAIL="you@example.com"        # your Atlassian account email (basic auth)
export WEAVN_JIRA_TOKEN="paste-your-api-token-here"
export WEAVN_PROJECT="BC"                        # a scratch project key to demo into

# Auth mode: "basic" = JIRA Cloud (email + token, the default); "bearer" = a true PAT (no email).
export WEAVN_JIRA_AUTH="basic"

# Optional: an indexed custom field id to hold the channel id (e.g. customfield_10050).
# Leave commented out to tag issues with a label instead — fine for the demo.
# export WEAVN_CHANNEL_FIELD="customfield_10050"
