# Copy to  scripts/oidc.env  (git-ignored) to turn on Okta/SSO, then run the gateway.
# Create an OIDC web app in Okta; set the sign-in redirect URI to the callback below.
export WEAVN_OIDC_ISSUER="https://<your-org>.okta.com/oauth2/default"
export WEAVN_OIDC_CLIENT_ID="0oaXXXXXXXXXXXXXXXXX"
export WEAVN_OIDC_CLIENT_SECRET="paste-client-secret-here"
export WEAVN_OIDC_REDIRECT_URL="http://localhost:8080/auth/callback"
